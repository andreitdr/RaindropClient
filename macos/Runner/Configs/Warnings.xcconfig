WARNING_CFLAGS = -Wall -Wconditional-uninitialized -Wnullable-to-nonnull-conversion -Wmissing-method-return-type -Woverlength-strings
GCC_WARN_UNDECLARED_SELECTOR = YES
CLANG_UNDEFINED_BEHAVIOR_SANITIZER_NULLABILITY = YES
CLANG_WARN_UNGUARDED_AVAILABILITY = YES_AGGRESSIVE
CLANG_WARN__DUPLICATE_METHOD_MATCH = YES
CLANG_WARN_PRAGMA_PACK = YES
CLANG_WARN_STRICT_PROTOTYPES = YES
CLANG_WARN_COMMA = YES
GCC_WARN_STRICT_SELECTOR_MATCH = YES
CLANG_WARN_OBJC_REPEATED_USE_OF_WEAK = YES
CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF = YES
GCC_WARN_SHADOW = YES
CLANG_WARN_UNREACHABLE_CODE = YES

// Warnings are errors in this app's own code (Runner's Swift). A release cannot be published while
// any platform warns; see docs/ci-and-releases.md. Plugins' pods are built under their own settings.
// Swift only: Runner's own code is all Swift. GCC_TREAT_WARNINGS_AS_ERRORS is deliberately not set —
// clang would apply it while precompiling third-party plugins' generated Swift headers as modules for
// Runner to import (media_kit_video's and mobile_scanner's warn), failing the build on code that is
// not ours.
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
// Swift passes -Werror on to clang when it precompiles the plugins' generated Swift headers it imports,
// and media_kit_video's and mobile_scanner's raise clang's ignored-attributes warning
// (`__unsafe_unretained` on a CVPixelBufferRef). Keep that one diagnostic a warning; every other
// warning — and every warning in our Swift — still fails the build.
OTHER_SWIFT_FLAGS = $(inherited) -Xcc -Wno-error=ignored-attributes
